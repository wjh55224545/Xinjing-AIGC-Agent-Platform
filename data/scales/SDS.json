{
  "code": "SDS",
  "name": "抑郁自评量表",
  "description": "Zung 抑郁自评量表（SDS, 1965），用于评估个体近一周的抑郁状态。20 个条目，4 点计分，标准分 = 粗分 × 1.25。量表条目来源：Zung, W. W. K. (1965). A self-rating depression scale. Archives of General Psychiatry, 12, 63-70.",
  "source": "Zung (1965). A self-rating depression scale. Archives of General Psychiatry, 12, 63-70.",
  "questions_count": 20,
  "questions": [
    {"id": 1, "text": "我觉得闷闷不乐，情绪低沉", "irt": {"a": 1.4, "b": -1.0, "c": 0.1}},
    {"id": 2, "text": "我觉得一天之中早晨最好", "irt": {"a": 0.7, "b": -0.5, "c": 0.1}},
    {"id": 3, "text": "我一阵阵哭出来或觉得想哭", "irt": {"a": 1.3, "b": 0.5, "c": 0.12}},
    {"id": 4, "text": "我晚上睡眠不好", "irt": {"a": 1.0, "b": 0.3, "c": 0.1}},
    {"id": 5, "text": "我吃得跟平常一样多", "irt": {"a": 0.8, "b": -0.6, "c": 0.1}},
    {"id": 6, "text": "我与异性密切接触时和以往一样感到愉快", "irt": {"a": 0.9, "b": 0.2, "c": 0.1}},
    {"id": 7, "text": "我发觉我的体重在下降", "irt": {"a": 0.8, "b": 1.2, "c": 0.1}},
    {"id": 8, "text": "我有便秘的苦恼", "irt": {"a": 0.7, "b": 1.1, "c": 0.1}},
    {"id": 9, "text": "我心跳比平常快", "irt": {"a": 0.9, "b": 0.7, "c": 0.1}},
    {"id": 10, "text": "我无缘无故地感到疲乏", "irt": {"a": 1.2, "b": -0.1, "c": 0.1}},
    {"id": 11, "text": "我的头脑跟平常一样清楚", "irt": {"a": 1.0, "b": -0.8, "c": 0.1}},
    {"id": 12, "text": "我觉得经常做的事情并没有困难", "irt": {"a": 1.0, "b": -0.4, "c": 0.1}},
    {"id": 13, "text": "我觉得不安而平静不下来", "irt": {"a": 1.3, "b": 0.1, "c": 0.1}},
    {"id": 14, "text": "我对将来抱有希望", "irt": {"a": 1.1, "b": -1.2, "c": 0.1}},
    {"id": 15, "text": "我比平常容易生气激动", "irt": {"a": 1.0, "b": 0.6, "c": 0.1}},
    {"id": 16, "text": "我觉得作出决定是容易的", "irt": {"a": 0.9, "b": -0.7, "c": 0.1}},
    {"id": 17, "text": "我觉得自己是个有用的人，有人需要我", "irt": {"a": 1.1, "b": -1.4, "c": 0.1}},
    {"id": 18, "text": "我的生活过得很有意思", "irt": {"a": 1.1, "b": -1.0, "c": 0.1}},
    {"id": 19, "text": "我认为如果我死了别人会生活得好些", "irt": {"a": 1.6, "b": 1.6, "c": 0.15}},
    {"id": 20, "text": "平常感兴趣的事我仍然照样感兴趣", "irt": {"a": 1.0, "b": -0.9, "c": 0.1}}
  ],
  "scoring": {
    "base": 1,
    "labels": ["没有或很少时间", "小部分时间", "相当多时间", "绝大部分或全部时间"],
    "options": [1, 2, 3, 4],
    "reverse_items": [2, 5, 6, 11, 12, 14, 16, 17, 18, 20],
    "standard_score_formula": "raw_x_125",
    "cutoff": {"normal": [0, 52], "mild": [53, 62], "moderate": [63, 72], "severe": [73, 999]},
    "note": "标准分 <53 正常，53-62 轻度抑郁，63-72 中度抑郁，≥73 重度抑郁。条目 2/5/6/11/12/14/16/17/18/20 为反向计分。IRT 参数为初始锚定值，可依据标注数据校正。"
