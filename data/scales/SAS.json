    {"id": 6, "text": "我手脚发抖打颤", "irt": {"a": 1.1, "b": 0.4, "c": 0.1}},
    {"id": 7, "text": "我因为头痛、颈痛和背痛而苦恼", "irt": {"a": 0.9, "b": 0.6, "c": 0.1}},
    {"id": 8, "text": "我感觉容易衰弱和疲乏", "irt": {"a": 1.1, "b": -0.2, "c": 0.1}},
    {"id": 9, "text": "我觉得心平气和，并且容易安静坐着", "irt": {"a": 1.0, "b": -1.0, "c": 0.1}},
    {"id": 10, "text": "我觉得心跳得很快", "irt": {"a": 1.2, "b": 0.2, "c": 0.1}},
    {"id": 11, "text": "我因为一阵阵头晕而苦恼", "irt": {"a": 1.0, "b": 0.8, "c": 0.1}},
    {"id": 12, "text": "我有晕倒发作，或觉得要晕倒似的", "irt": {"a": 1.3, "b": 1.4, "c": 0.15}},
    {"id": 13, "text": "我呼气吸气都感到很容易", "irt": {"a": 0.8, "b": -1.4, "c": 0.1}},
    {"id": 14, "text": "我手脚麻木和刺痛", "irt": {"a": 0.9, "b": 1.0, "c": 0.1}},
    {"id": 15, "text": "我因为胃痛和消化不良而苦恼", "irt": {"a": 0.8, "b": 0.9, "c": 0.1}},
    {"id": 16, "text": "我常常要小便", "irt": {"a": 0.7, "b": 1.2, "c": 0.1}},
    {"id": 17, "text": "我的手常常是干燥温暖的", "irt": {"a": 0.7, "b": -1.1, "c": 0.1}},
    {"id": 18, "text": "我脸红发热", "irt": {"a": 0.8, "b": 0.7, "c": 0.1}},
    {"id": 19, "text": "我容易入睡并且一夜睡得很好", "irt": {"a": 0.8, "b": -0.9, "c": 0.1}},
