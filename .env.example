# ============================================================
# 心镜·AIGC智能体平台 环境变量模板
# 复制为 .env 后填写真实值（.env 不要提交到版本库）
# ============================================================

# ---------- AI 算力平台（主平台选择：lingshu / gitee_ai / deepseek / local / custom） ----------
AI_PLATFORM=gitee_ai

# 通用 API Key（各平台独立 Key 未设置时使用）
AI_API_KEY=

# Lingshu-32B — moark.com（沐曦 MetaX GPU，OpenAI 兼容）
LINGSHU_API_KEY=
LINGSHU_BASE_URL=https://api.moark.com/v1
LINGSHU_MODEL=Lingshu-32B

# Gitee.AI（沐曦 MetaX GPU）
GITEE_AI_API_KEY=
GITEE_AI_BASE_URL=https://api.gitee.ai/v1
GITEE_AI_MODEL=qwen2.5-7b-instruct

# DeepSeek（备用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 本地模型（Ollama 等）
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b

# 备用平台列表（逗号分隔）
AI_FALLBACK_PLATFORMS=deepseek

# ---------- 数据库 ----------
# 默认 SQLite：sqlite:///./data/psych.db
# DATABASE_URL=sqlite:///./data/psych.db

# ---------- 华为云 OBS（可选） ----------
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET=psych-monitor
OBS_AK=
OBS_SK=

# ---------- 服务 ----------
# 端口由启动脚本/uvicorn 控制；版本号由代码统一管理
# SERVICE_VERSION=2.4.0

# ---------- 调度器 ----------
INNER_LOOP_INTERVAL_MINUTES=15
OUTER_LOOP_CRON_HOUR=22
OUTER_LOOP_CRON_MINUTE=0
